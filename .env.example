PORT=8080
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
APP_TIMEZONE=Asia/Jakarta
SESSION_TTL=24h
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=10485760
MAX_PHOTO_CHARS=45000
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
MIMO_TIMEOUT=25s
# Satu shift alat berat, dipakai Input HM untuk menghitung sisa waktu
# yang harus dipecah ke standby dan breakdown.
A2B_WORK_MINUTES=720
# Jam kerja yang dipakai menilai setiap absensi. Format 24 jam HH:MM.
ATTENDANCE_START=07:00
ATTENDANCE_END=17:00
ATTENDANCE_LATE_TOLERANCE_MINUTES=15
COMPANY_NAME=PT Orecon Putra Perkasa
SIGNATORY_NAME=
SIGNATORY_TITLE=Direktur
SIGNATORY_PLACE=
# Widya Load Scanner, dibaca menu Produksi New. Kosongkan bila belum dipakai.
WIDYA_URL=https://wls-star.widyarobotics.com
WIDYA_EMAIL=
WIDYA_PASSWORD=
# Company-Id untuk login. Kosongkan: dibaca otomatis dari config Widya.
WIDYA_LOGIN_COMPANY=
WIDYA_REFRESH=30s
